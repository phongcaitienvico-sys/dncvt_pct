# Cấu hình kết nối Supabase (sao chép thành .env khi chạy script / local dev; KHÔNG commit .env)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres
SYNTHETIC_EMAIL_DOMAIN=dncvt.local
INITIAL_USER_PASSWORD=change-me-at-cutover

